NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Auth (Supabase Dashboard → Authentication → Providers):
# - Enable Google (add OAuth client ID/secret; redirect URL: https://YOUR_DOMAIN/auth/callback)
# - Enable Email; turn OFF "Confirm email" for instant sign-up without verification

# Required for npm run setup:demo (Dashboard → Settings → Database → password)
SUPABASE_DB_PASSWORD=your_database_password
